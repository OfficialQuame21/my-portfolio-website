# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. Everything prefixed with VITE_ is bundled
# into the client, so ONLY put public values here — never a private API key or
# secret of any kind.
# ---------------------------------------------------------------------------

# Optional. When set, the contact form appears next to the email card.
# Leave it unset and the site falls back to the (always working) mailto links.
#
# Use any service that accepts a JSON POST and emails you the result, e.g.
#   Formspree  — https://formspree.io/f/your-form-id
#   Web3Forms  — https://api.web3forms.com/submit
#   Your own serverless function
#
# These endpoint URLs are public by design; the secret stays with the provider.
VITE_CONTACT_ENDPOINT=
